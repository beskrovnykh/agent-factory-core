# Конфигурация ИНСТАЛЛЯЦИИ — не продукта. Своя у каждого клиента.
# Скопировать, заполнить, передать install.sh через --config.

# Как называется эта инсталляция. Идёт в описание юнита и в логи — чтобы на
# хосте с несколькими было видно, чей раннер.
INSTANCE="client-b"

# От кого работает раннер и где лежит ядро.
RUN_USER="ubuntu"
HOME_DIR="/home/ubuntu/agent-runner"

# Файл с секретами и настройками инсталляции. Если его нет — установщик
# напишет заготовку и скажет, что дозаполнить; существующий НЕ перезаписывает,
# он переживает обновления ядра. Что в нём должно быть:
#
#   CLAUDE_CODE_OAUTH_TOKEN   токен модели
#   REDIS_URL                 очередь задач
#   LINEAR_API_KEY            ключ трекера
#   TELEGRAM_BOT_TOKEN        канал уведомлений
#   AGENT_MEMORY_STORE        СВОЙ стор памяти этой инсталляции (DEV-32)
#   AGENT_PERSON_MEMORY       слой памяти о человеке — ЛИЧНЫЙ стор владельца,
#                             вне стора инсталляции (DEV-43); пусто — слоя нет
#   AGENT_KNOWN_REPOS         репозитории проекта
#   AGENT_ENV_CANON           что здесь прод, а что нет
#   AGENT_AUTOMERGE_ZONES     что агент вливает сам (пусто — ничего)
#   AGENT_MAX_WORK_ROUNDS     потолок рабочих заходов на задачу (умолчание 3,
#                             0 — без потолка): назначение на агента сверх него
#                             сессию не поднимает, задача уходит принимающему
#   AGENT_MAX_HANDOFF_ATTEMPTS потолок неудачных сдач подряд (умолчание 3, ноль
#                             = умолчание): сдача не по схеме возвращается
#                             сессии, на потолке задача уходит принимающему
#   AGENT_GIT_TIMEOUT_SEC     сколько ворота перед проверкой ждут одну команду
#                             git (умолчание 20); ворота читают AGENT_REPOS_ROOT
#                             и AGENT_WORK_ROOT — те же, что у раннера
#   AGENT_VERIFY_BEFORE_MERGE проверка ДО мержа — ветка на dev-стенде: 1/0,
#                             умолчание 1
#   CLAUDE_CODE_MAX_SUBAGENT_SPAWN_DEPTH
#   CLAUDE_CODE_MAX_CONCURRENT_SUBAGENTS
#                             потолки под-агентов — переменные CLI (DEV-91):
#                             глубина вложения и сколько одновременно. Пусто —
#                             раннер ставит 1 и 2; умолчания CLI — 3 и 20
#   AGENT_REPEAT_BASH_LIMIT   прерыватель: столько одинаковых Bash подряд —
#                             сессия снимается (умолчание 8, 0 — выключен)
#   AGENT_STOP_KEY_PREFIX     ключ команды /stop (умолчание agent:stop); один
#                             и тот же у приёма и раннера
#   AGENT_CI_WAIT_MAX_SEC     ожидание проверок CI за раннером (DEV-16): сколько
#                             ждать исхода (умолчание 5400 — 90 мин, обязано
#                             быть больше срока сессии); AGENT_CI_WAIT_POLL_SEC
#                             — опрос форжа (120), AGENT_CI_WAIT_APPEAR_SEC —
#                             сколько ждать появления прогона (900),
#                             AGENT_CI_WAIT_HEARTBEAT_SEC — раз в сколько
#                             говорить «всё ещё ждём» (1800), AGENT_CI_WAKE_MAX_SEC
#                             — сколько продолжению после красного дают
#                             подняться (7200), AGENT_MAX_CI_FIX_ATTEMPTS —
#                             возвраты сессии чинить красный (2)
#   AGENT_VERIFY_AFTER_MERGE  проверка ПОСЛЕ мержа — выкат на прод: 1/0,
#                             умолчание 1. Выключенная точка сессию в очередь
#                             не ставит вовсе (экономия токенов), код цел —
#                             включается обратно этой же переменной. На
#                             client-b и client-a стоит 0: после мержа владелец
#                             проверяет сам. Читаются на старте приёма и
#                             раннера — после смены перезапустить оба юнита
#
# Осторожно: значения, содержащие скобки, обязаны быть в кавычках — иначе
# любой bash-потребитель этого файла молча теряет всё после такой строки.
ENV_FILE="/home/ubuntu/.agent-runner-env"

# Стор памяти ЭТОЙ инсталляции. Свой, не общий: подключаемая память — то, без
# чего фабрику нельзя поставить никому, не отдав вместе с ней чужой опыт.
# Установщик заведёт каталоги четырёх ролей и каталог переопределений
# методологии (`methodology/`), если их нет.
#
# Каталог обязан быть ВЫДЕЛЕННЫМ: его отдают клиенту вместе с установкой.
# Внутри личного стора владельца ему не место — там память его собственных
# проектов, и вместе со стором уехала бы она (DEV-43). Личный слой владельца
# подключается отдельно, через AGENT_PERSON_MEMORY в файле окружения.
MEMORY_STORE="/home/ubuntu/agent-memory"

# Где сессии работают и куда клонируются репозитории проекта.
# По умолчанию — внутри HOME_DIR.
# WORK_ROOT="/home/ubuntu/agent-work"
# REPOS_ROOT="/home/ubuntu/repos"

# Каталог, где лежит claude. У fnm он внутри каталога версии, а не в
# системном PATH: без этого юнит стартует, а сессия падает на spawn ENOENT.
NODE_BIN="/home/ubuntu/.local/share/fnm/aliases/default/bin"

# Необязательное, со значениями по умолчанию.

# Интерпретатор. По умолчанию НЕ задан — установщик добудет свой (uv ставит
# standalone-сборку в домашний каталог, без root и без PPA) и сделает venv.
# Так стек не зависит от того, что стоит на хосте, и не лезет в системный
# питон, на котором живут чужие сервисы.
#
# Задавать имеет смысл, только если у инсталляции уже есть подходящий.
# PYTHON="/usr/bin/python3.12"
PYTHON_VERSION="3.12"
MEMORY_MAX="4G"        # общий потолок на все слоты
CPU_QUOTA="150%"
UNIT_NAME="agent-runner"
